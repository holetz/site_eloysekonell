---
import { Image } from 'astro:assets';
import logoDatarunk from '../assets/logos/logo_datarunk.png';
import logoDgsis from '../assets/logos/logo_dgsis.png';
import logoGrupoTop from '../assets/logos/logo_grupo_top.png';
import logoPossibilitar from '../assets/logos/logo_possibilitar.png';
import logoNuvme from '../assets/logos/logo_nuvme.png';
import logoStraas from '../assets/logos/logo_straas.png';
import logoColablife from '../assets/logos/logo_colablife.png';
import logoTechlinker from '../assets/logos/logo_techlinker.webp';
import logoMtech from '../assets/logos/logo_mtech.png';
import logoGuion from '../assets/logos/logo_guion.png';
import logoOliveiraRitzmann from '../assets/logos/logo_oliveira_ritzmann.png';
import logoDati from '../assets/logos/logo_dati.png';
import logoSingularis from '../assets/logos/logo_singularis.svg';
import logoStraasSchool from '../assets/logos/logo_straas_school.webp';

const clients = [
  { src: logoDatarunk,    alt: 'DataRunk',     href: 'https://datarunk.com/' },
  { src: logoDgsis,       alt: 'DG SYS',       href: 'https://dgsys.com.br/' },
  { src: logoGrupoTop,    alt: 'GTOP',         href: 'https://www.gtopdistribuicao.com.br/' },
  { src: logoPossibilitar,alt: 'Possibilitar' },
  { src: logoNuvme,       alt: 'Nuvme',        href: 'https://nuvme.com.br/' },
  { src: logoStraas,      alt: 'Straas',       href: 'https://straas.co/' },
  { src: logoColablife,   alt: 'ColabLife',    href: 'https://colablife.dgsys.com.br/' },
  { src: logoTechlinker,  alt: 'TechLinker',   href: 'https://techlinker.com.br/' },
  { src: logoMtech,       alt: 'MTech Systems', href: 'https://mtechsystems.io/' },
  { src: logoGuion,       alt: 'Greentex Química', href: 'https://www.greentexquimica.com.br/' },
  { src: logoOliveiraRitzmann, alt: 'Oliveira Ritzmann Advogados', href: 'https://oliveiraritzmann.com.br/' },
  { src: logoDati,        alt: 'Dati',         href: 'https://dati.com.br/' },
  { src: logoSingularis,  alt: 'Singularis RH', href: 'https://www.singularisrh.com.br/' },
  { src: logoStraasSchool, alt: 'straas.school', href: 'https://straas.school/' },
];
---
<!-- CLIENTES -->
<section class="clients">
  <div class="wrap">
    <div class="clients-head reveal">
      <span class="eyebrow">Alianças que Transformam</span>
    </div>
    <div class="clients-grid reveal delay-1">
      {clients.map(({ src, alt, href }) => {
        const logo = (
          <Image
            class="client-logo"
            src={src}
            alt={alt}
            width={240}
            height={80}
            loading="lazy"
            formats={['avif', 'webp']}
          />
        );
        return href ? (
          <a class="client-link" href={href} target="_blank" rel="noopener noreferrer" title={alt}>
            {logo}
          </a>
        ) : logo;
      })}
    </div>
  </div>
</section>
