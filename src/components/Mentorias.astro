---
const mentorias = [
  {
    etiqueta: 'Primeira liderança',
    nome: 'Virei líder, e agora?',
    paraQuem: 'Para quem acabou de assumir a liderança e ainda tenta ser o melhor técnico do time.',
    resultados: [
      'Descubra o seu jeito de liderar',
      'Entregue através das pessoas',
      'Conduza conversas difíceis com segurança',
    ],
    formato: '8 encontros · turma de até 10 pessoas',
    botao: 'Quero entrar na próxima turma',
    link: 'https://api.whatsapp.com/send/?phone=5547991443844&text=Ol%C3%A1%20Eloyse%2C%20vim%20pelo%20site.%20Tenho%20interesse%20na%20mentoria%20Virei%20l%C3%ADder%2C%20e%20agora%3F',
  },
  {
    etiqueta: 'Líder de líderes',
    nome: 'Alcançando Novas Altitudes',
    paraQuem: 'Para quem passou a liderar líderes e viu que o jeito de antes não funciona mais.',
    resultados: [
      'Seus líderes decidem, você direciona',
      'Saia do operacional e ganhe tempo para pensar',
      'Faça a estratégia chegar até a ponta do time',
    ],
    formato: '8 encontros · turma de até 6 pessoas',
    botao: 'Quero entrar na primeira turma',
    link: 'https://api.whatsapp.com/send/?phone=5547991443844&text=Ol%C3%A1%20Eloyse%2C%20vim%20pelo%20site.%20Tenho%20interesse%20na%20mentoria%20Alcan%C3%A7ando%20Novas%20Altitudes',
  },
];
---
<!-- MENTORIAS EM GRUPO -->
<section class="mentorias" id="mentorias">
  <div class="wrap">
    <div class="services-head reveal">
      <span class="eyebrow">Mentorias em grupo</span>
      <h2>Para cada virada da liderança, <em>uma mentoria</em></h2>
      <p>Escolha o momento em que você está.</p>
    </div>

    <div class="mentorias-grid">
      {mentorias.map((m, i) => (
        <article class={`mentoria-card reveal ${i > 0 ? 'delay-1' : ''}`}>
          <span class="mentoria-card__tag">{m.etiqueta}</span>
          <h3>{m.nome}</h3>
          <p class="mentoria-card__para">{m.paraQuem}</p>
          <ul class="mentoria-card__resultados">
            {m.resultados.map((r) => (
              <li>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                {r}
              </li>
            ))}
          </ul>
          <div class="mentoria-card__foot">
            <p class="mentoria-card__formato">{m.formato}</p>
            <a href={m.link} class="btn" target="_blank" rel="noopener">{m.botao}</a>
          </div>
        </article>
      ))}
    </div>

    <p class="mentorias-foot reveal">
      Quer desenvolver os líderes da sua empresa? <a href="/assessment/" class="link-arrow">Conheça o Diagnóstico de Liderança</a>
    </p>
  </div>
</section>

<style>
  .mentorias {
    background: var(--olive-deep);
    overflow: hidden;
  }

  .mentorias::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 50% 60% at 50% 0%, rgba(168, 134, 86, 0.18), transparent 70%);
  }

  .mentorias .wrap {
    position: relative;
    z-index: 1;
  }

  .mentorias .services-head {
    margin-bottom: var(--space-9);
  }

  .mentorias .services-head .eyebrow {
    color: var(--bronze-soft);
  }

  .mentorias .services-head h2 {
    color: var(--sand);
  }

  .mentorias .services-head h2 em {
    white-space: nowrap;
    color: var(--bronze-soft);
  }

  .mentorias .services-head p {
    color: rgba(241, 235, 224, 0.78);
  }

  .mentorias-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-7);
    align-items: stretch;
  }

  .mentoria-card {
    background: var(--sand-warm);
    border: 1px solid var(--sand-deep);
    border-radius: var(--radius-sm);
    padding: var(--space-8) var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .mentoria-card__tag {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--bronze);
  }

  .mentoria-card h3 {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    font-weight: 500;
    color: var(--olive-deep);
    margin: 0;
    line-height: 1.15;
  }

  .mentoria-card__para {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.12rem;
    line-height: 1.55;
    color: var(--taupe);
    margin: 0;
  }

  .mentoria-card__resultados {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .mentoria-card__resultados li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    color: #514a3e;
    line-height: 1.5;
  }

  .mentoria-card__resultados svg {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--bronze);
  }

  .mentoria-card__foot {
    margin-top: auto;
    padding-top: var(--space-6);
    border-top: var(--border-line);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .mentoria-card__formato {
    font-family: var(--sans);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--taupe);
    margin: 0;
  }

  .mentorias-foot {
    margin-top: var(--space-9);
    text-align: center;
    color: rgba(241, 235, 224, 0.78);
  }

  .mentorias-foot .link-arrow {
    color: var(--bronze-soft);
  }

  @media (max-width: 900px) {
    .mentorias-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }

  @media (max-width: 500px) {
    .mentoria-card {
      padding: var(--space-7) var(--space-6);
    }

    .mentoria-card .btn {
      width: 100%;
      text-align: center;
      padding-left: var(--space-5);
      padding-right: var(--space-5);
    }
  }
</style>
