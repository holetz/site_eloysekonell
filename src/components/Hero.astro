---
import { Image } from 'astro:assets';
import heroImg from '../assets/photos/eloyse-hero.jpg';
import { credenciais } from '../data/credenciais';
---
<!-- HERO -->
<section class="hero">
  <div class="wrap">
    <div class="hero-grid">
      <div>
        <span class="eyebrow reveal">Psicóloga · Consultora para Líderes e Organizações</span>
        <h1 class="reveal delay-1">
          Estratégias para líderes e pessoas <em>que movem negócios</em>
        </h1>
        <p class="lead reveal delay-2">
          Há mais de {credenciais.anosGestaoPessoas} anos conecto liderança e gestão de pessoas à estratégia do negócio, estruturando o RH e preparando os líderes que vão sustentar o próximo ciclo de crescimento.
        </p>
        <div class="hero-cta reveal delay-3">
          <a href="/#contato" class="btn">AGENDAR UMA CONVERSA</a>
          <a href="/servicos/" class="btn-ghost">CONHECER AS SOLUÇÕES</a>
        </div>
      </div>
      <div class="hero-visual reveal delay-2">
        <div class="photo">
          <Image
            src={heroImg}
            alt="Eloyse Konell — Consultora em Liderança e Gestão Estratégica de Pessoas"
            loading="eager"
            fetchpriority="high"
            widths={[460, 920]}
            sizes="(max-width: 900px) 360px, 460px"
          />
        </div>
        <div class="hero-mark">
          <strong>{credenciais.anosGestaoPessoas}+ anos</strong>
          transformando gestão de pessoas e liderança em vantagem competitiva.
        </div>
      </div>
    </div>
  </div>
</section>
