---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import leadershipIcon from '../../assets/icons/leadership.svg?raw';
import strategyIcon from '../../assets/icons/strategy.svg?raw';
import assessmentIcon from '../../assets/icons/assessment.svg?raw';
import mentoringIcon from '../../assets/icons/mentoring.svg?raw';
import successionIcon from '../../assets/icons/succession.svg?raw';
import peopleStrategyIcon from '../../assets/icons/people-strategy.svg?raw';

const SITE_URL = 'https://eloysekonell.com.br';

const title = 'Serviços — Eloyse Konell | Liderança e Gestão Estratégica de Pessoas';
const description =
  'Diagnóstico e arquitetura organizacional, assessment de lideranças, sucessão, desenvolvimento de líderes, mentoria e consultoria em gestão de pessoas para empresas no Sul do Brasil.';
const canonical = `${SITE_URL}/servicos/`;

const breadcrumb = [
  { label: 'Início', href: '/' },
  { label: 'Serviços' },
];

const services = [
  {
    title: 'Diagnóstico Integrado e Arquitetura Organizacional',
    deck: 'Para empresas que cresceram e precisam saber se a estrutura atual, a começar pela liderança, sustenta o próximo ciclo do negócio.',
    iconHtml: strategyIcon,
    bullets: [
      'Leitura da estrutura a partir da liderança: desenho, tamanho e o time que cada líder carrega',
      'Análise cruzada de estratégia, estrutura e pessoas para avaliar se os times sustentam o negócio',
      'Arquitetura-alvo de lideranças e times, com as posições críticas mapeadas',
      'Plano de transição priorizado, com marcos e sequenciamento',
    ],
  },
  {
    title: 'Assessment para Lideranças',
    deck: 'Para empresas que precisam de uma leitura objetiva de quem lidera hoje antes de decidir sobre promoção, sucessão, contratação ou investimento em desenvolvimento.',
    iconHtml: assessmentIcon,
    bullets: [
      'Instrumentos psicométricos validados — PDA/DISC, TEIQue, HPTI e Dilemas de Gestão — combinados a uma entrevista de profundidade',
      'Análise lida à luz do contexto, da estratégia e dos desafios concretos de cada posição, sem relatórios genéricos',
      'Relatório individual, devolutiva ao avaliado e síntese executiva ao patrocinador',
      'Indicação clara de onde investir primeiro em desenvolvimento',
    ],
  },
  {
    title: 'Estratégias de Sucessão',
    deck: 'Para empresas que precisam proteger o negócio nos ciclos de transição e deixar de decidir movimentações de forma reativa.',
    iconHtml: successionIcon,
    bullets: [
      'Mapeamento das posições críticas e dos profissionais com potencial para ocupá-las',
      'Avaliação de prontidão e potencial de cada sucessor frente à criticidade do cargo',
      'Planos de desenvolvimento dirigidos às lacunas críticas, com sucessores preparados em camadas',
      'Planejamento de carreira e governança do pipeline de sucessão',
    ],
  },
  {
    title: 'Desenvolvimento de Líderes',
    deck: 'Para empresas que precisam preparar a liderança para a próxima fase de crescimento, com programas ligados à estratégia e não a um catálogo pronto de treinamentos.',
    iconHtml: leadershipIcon,
    bullets: [
      'Diagnóstico do grupo — competências, estilos e contexto estratégico — antes de desenhar o programa',
      'Jornadas customizadas pelo Método LIA, com cases do próprio negócio e aplicação em desafios reais',
      'Mentorias individuais em paralelo para cada líder',
      'Medição da evolução comportamental antes e depois, não apenas da satisfação ao final',
    ],
  },
  {
    title: 'Mentoria',
    deck: 'Para quem quer liderar melhor ou precisa reposicionar a carreira com clareza, em um processo individual e orientado a resultado.',
    iconHtml: mentoringIcon,
    bullets: [
      'Desenvolvimento de liderança pelo Método LIA (Ler, Integrar e Agir), em 8 encontros, nas trilhas “Virei líder, e agora?” e “Nova altitude”',
      'Transição de carreira em 6 encontros e quatro pilares: identidade, voz e essência, direção e movimento',
      'Tarefas práticas entre encontros, aplicadas no trabalho e na carreira real',
      'Plano de ação e PDI com linha de base para medir a evolução',
    ],
  },
  {
    title: 'Consultoria Estratégica de Gestão de Pessoas',
    deck: 'Para empresas que querem que a gestão de pessoas deixe de ser reativa e passe a trabalhar a serviço da estratégia do negócio.',
    iconHtml: peopleStrategyIcon,
    bullets: [
      'Diagnóstico da gestão de pessoas — práticas, cultura, políticas e estrutura — frente à estratégia',
      'Projetos de cultura, pesquisa de clima, avaliação de desempenho, cargos e salários e recrutamento e seleção',
      'Contratação por projeto, com escopo e prazo fechados, ou como RH as a Service, em parceria mensal para empresas sem RH estruturado',
      'Acompanhamento recorrente, com síntese executiva periódica',
    ],
  },
];

const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': canonical,
  name: 'Serviços',
  url: canonical,
  description,
  inLanguage: 'pt-BR',
  isPartOf: { '@id': `${SITE_URL}/#business` },
  hasPart: [
    { '@id': `${SITE_URL}/servicos/assessment/#service` },
    { '@id': `${SITE_URL}/servicos/estrategias-de-sucessao/#service` },
    { '@id': `${SITE_URL}/servicos/mentoria-transicao-carreira/#service` },
    { '@id': `${SITE_URL}/servicos/desenvolvimento-de-liderancas/#service` },
    { '@type': 'Service', name: 'Diagnóstico Integrado e Arquitetura Organizacional' },
    { '@type': 'Service', name: 'Consultoria Estratégica de Gestão de Pessoas' },
  ],
};
---

<PageLayout
  title={title}
  description={description}
  canonical={canonical}
  breadcrumb={breadcrumb}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(collectionPageSchema)} />
  </Fragment>

  <PageHero
    slot="hero"
    eyebrow="Serviços"
    title="Como posso ajudar"
    deck="Seis serviços para empresas e líderes que querem decidir sobre pessoas com o mesmo critério que usam para decidir sobre o negócio."
  />

  <div class="servicos-wrap">
    <p class="servicos-intro">
      Pessoas movem negócios, e quem move as pessoas dentro de uma organização é a liderança.
      Quando ela não acompanha o momento da empresa, a estratégia perde força onde mais importa:
      na execução.
    </p>
    <p class="servicos-intro">
      Por isso parto sempre da leitura do negócio e coloco a liderança no centro: a estrutura em
      que ela opera, as práticas de gestão de pessoas que a apoiam e o desenvolvimento que a
      prepara para o próximo ciclo. Os seis serviços abaixo se organizam em três frentes
      integradas — estruturar, avaliar e desenvolver — e foram desenhados como respostas a
      perguntas reais, não como pacotes genéricos.
    </p>

    <div class="servicos-grid">
      {services.map((s) => (
        <ServiceCard
          title={s.title}
          deck={s.deck}
          href={s.href}
          iconHtml={s.iconHtml}
          bullets={s.bullets}
        />
      ))}
    </div>

    <div class="servicos-cta">
      <p class="servicos-cta__text">Não sabe qual serviço encaixa? Vamos conversar.</p>
      <a href="/contato/" class="btn-ghost">Falar com Eloyse →</a>
    </div>
  </div>
</PageLayout>

<style>
  .servicos-wrap {
    padding-bottom: var(--space-11);
  }

  .servicos-intro {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--taupe);
    margin: 0 0 var(--space-5);
  }

  .servicos-intro:last-of-type {
    margin-bottom: var(--space-10);
  }

  .servicos-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-7);
    margin-bottom: var(--space-10);
  }

  .servicos-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-10) 0;
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .servicos-cta__text {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    color: var(--olive-deep);
    margin: 0;
  }

  @media (max-width: 900px) {
    .servicos-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .servicos-intro:last-of-type {
      margin-bottom: var(--space-8);
    }

    .servicos-grid {
      gap: var(--space-5);
    }

    .servicos-cta {
      padding: var(--space-9) 0;
    }
  }
</style>
